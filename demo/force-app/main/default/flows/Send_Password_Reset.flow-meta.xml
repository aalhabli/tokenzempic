<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <assignments>
        <name>Confirm_Sent</name>
        <label>Confirm Sent</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>confirmation_message</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>sent_message</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>No_Account</name>
        <label>No Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>confirmation_message</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>no_account_message</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Found_Contact</name>
        <label>Found Contact?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Contact_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contact</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Confirm_Sent</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Sends a password reset link to a Nimbus Coffee customer. Give it the customer's email address. It confirms whether a reset link was sent, or reports that no account exists for that email.</description>
    <environments>Default</environments>
    <formulas>
        <name>sent_message</name>
        <dataType>String</dataType>
        <expression>'A password reset link has been sent to ' &amp; {!customer_email} &amp; '. It expires in 24 hours.'</expression>
    </formulas>
    <formulas>
        <name>no_account_message</name>
        <dataType>String</dataType>
        <expression>'No Nimbus Coffee account was found for ' &amp; {!customer_email} &amp; '. Please check the spelling of the email address.'</expression>
    </formulas>
    <interviewLabel>Send Password Reset {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Send Password Reset</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <recordLookups>
        <name>Get_Contact</name>
        <label>Get Contact</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Found_Contact</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>customer_email</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Contact</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>The email address on the customer's Nimbus Coffee account.</description>
        <name>customer_email</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Confirmation that the reset link was sent, or a message that no account exists for the email.</description>
        <name>confirmation_message</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
