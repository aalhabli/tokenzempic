    <description>Returns the current status of a customer's coffee order. Give it the customer's email address, or a specific order number like CO-00042, and it returns a readable status message including items, total, ship date, estimated delivery, and tracking number.</description>
    <environments>Default</environments>
    <formulas>
        <name>order_message</name>
        <dataType>String</dataType>
        <expression>'Order ' &amp; {!order.Name} &amp; ': ' &amp; TEXT({!order.Status__c}) &amp; '. Items: ' &amp; {!order.Items__c} &amp; '. Total: $' &amp; TEXT({!order.Total_Amount__c}) &amp; '.' &amp; IF(ISBLANK({!order.Ship_Date__c}), '', ' Shipped on ' &amp; TEXT({!order.Ship_Date__c}) &amp; ', estimated delivery ' &amp; TEXT({!order.ETA__c}) &amp; '. Tracking number: ' &amp; {!order.Tracking_Number__c} &amp; '.')</expression>
    </formulas>
    <formulas>
        <name>not_found_message</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!order_number}), 'No orders found for ' &amp; {!customer_email} &amp; '.', 'No order found with number ' &amp; {!order_number} &amp; '.')</expression>
    </formulas>
    <interviewLabel>Get Order Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Get Order Status</label>
